# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Where created files are written (absolute or relative to this folder)
OUTPUT_DIR=./generated

# Ollama (same as rest of project)
OLLAMA_HOST=http://127.0.0.1:11434
